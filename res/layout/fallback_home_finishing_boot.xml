  ~
  ~ HalcyonOS: the pre-unlock "finishing boot" home. Instead of Android's
  ~ "phone is starting…" text + spinner, this is a plain black screen with the
  ~ HalcyonOS wordmark — a continuation of the boot, so nothing here reminds the
  ~ user they're on Android. The system bars are hidden via the FallbackHome theme.
  ~
  ~ The wordmark is a placeholder text logo; swap the TextView for an <ImageView
  ~ android:src="@drawable/…"/> once a real logo asset exists.
  -->

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:forceHasOverlappingRendering="false">

    <TextView
        android:id="@+id/halcyon_wordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="sans-serif-light"
        android:letterSpacing="0.32"
        android:textSize="34sp"
        android:textColor="#FFF4F7FA"
        android:text="HALCYON"/>

</FrameLayout>
